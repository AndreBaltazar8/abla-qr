// Reed-Solomon over GF(256) with the QR polynomial x^8 + x^4 + x^3 + x^2 + 1.

private fun buildExp(): array<int> {
    val table = filledArray(512, 0)
    var value = 1
    for (index in 0 until 255) {
        table[index] = value
        table[index + 255] = value
        value = value << 1
        if (value >= 256) value = value ^ 0x11D
    }
    table
}

private fun buildLog(exp: array<int>): array<int> {
    val table = filledArray(256, 0)
    for (index in 0 until 255) table[exp[index]] = index
    table
}

private val gfExp = buildExp()
private val gfLog = buildLog(gfExp)

fun qrGfMultiply(a: int, b: int): int =
    if (a == 0 || b == 0) 0 else gfExp[gfLog[a] + gfLog[b]]

// Division by zero is the caller's error; 0 keeps a damaged code from panicking.
fun qrGfDivide(a: int, b: int): int =
    if (a == 0 || b == 0) 0 else gfExp[gfLog[a] + 255 - gfLog[b]]

// Coefficients of the generator polynomial, highest power first, leading 1 omitted.
fun qrRsGenerator(degree: int): array<int> {
    val result = filledArray(degree, 0)
    result[degree - 1] = 1
    var root = 1
    for (step in 0 until degree) {
        for (index in 0 until degree) {
            result[index] = qrGfMultiply(result[index], root)
            if (index + 1 < degree) result[index] = result[index] ^ result[index + 1]
        }
        root = qrGfMultiply(root, 2)
    }
    result
}

fun qrRsRemainder(data: array<int>, divisor: array<int>): array<int> {
    val result = filledArray(divisor.size, 0)
    for (byte in data) {
        val factor = byte ^ result[0]
        for (index in 0 until result.size - 1) result[index] = result[index + 1]
        result[result.size - 1] = 0
        for (index in 0 until result.size)
            result[index] = result[index] ^ qrGfMultiply(divisor[index], factor)
    }
    result
}

private fun evaluate(polynomial: array<int>, x: int): int {
    // Lowest power first.
    var result = 0
    var index = polynomial.size - 1
    while (index >= 0) {
        result = qrGfMultiply(result, x) ^ polynomial[index]
        index -= 1
    }
    result
}

private fun syndromes(codeword: array<int>, eccCount: int): array<int> {
    val result = filledArray(eccCount, 0)
    for (index in 0 until eccCount) {
        val root = gfExp[index]
        var value = 0
        for (byte in codeword) value = qrGfMultiply(value, root) ^ byte
        result[index] = value
    }
    result
}

// Corrects `codeword` (data then check bytes) in place. Returns the number of
// corrected bytes, or -1 when more than `maxErrors` bytes are wrong.
fun qrRsCorrect(var codeword: array<int>, eccCount: int, maxErrors: int): int {
    val syndrome = syndromes(codeword, eccCount)
    var clean = true
    for (value in syndrome) if (value != 0) clean = false
    if (clean) return 0

    // Berlekamp-Massey: the error locator, lowest power first.
    var locator = filledArray(eccCount + 2, 0)
    var previous = filledArray(eccCount + 2, 0)
    locator[0] = 1
    previous[0] = 1
    var degree = 0
    var shift = 1
    var lastDiscrepancy = 1
    for (step in 0 until eccCount) {
        var discrepancy = syndrome[step]
        for (index in 1..degree) discrepancy = discrepancy ^ qrGfMultiply(locator[index], syndrome[step - index])
        if (discrepancy == 0) {
            shift += 1
        } else {
            val scale = qrGfDivide(discrepancy, lastDiscrepancy)
            val updated = filledArray(eccCount + 2, 0)
            for (index in 0 until updated.size) {
                updated[index] = locator[index]
                if (index >= shift) updated[index] = updated[index] ^ qrGfMultiply(scale, previous[index - shift])
            }
            if (2 * degree <= step) {
                previous = locator
                degree = step + 1 - degree
                lastDiscrepancy = discrepancy
                shift = 1
            } else {
                shift += 1
            }
            locator = updated
        }
    }
    if (degree > maxErrors) return -1

    // Omega = syndrome * locator mod x^eccCount.
    val omega = filledArray(eccCount, 0)
    for (index in 0 until eccCount)
        for (other in 0..index)
            omega[index] = omega[index] ^ qrGfMultiply(syndrome[other], locator[index - other])

    // Formal derivative of the locator.
    val derivative = filledArray(eccCount + 1, 0)
    var power = 1
    while (power < eccCount + 2) {
        derivative[power - 1] = locator[power]
        power += 2
    }

    var found = 0
    val size = codeword.size
    for (place in 0 until size) {
        // `place` is the power of x; byte `size - 1 - place` holds it.
        val inverse = gfExp[(255 - place % 255) % 255]
        if (evaluate(locator, inverse) == 0) {
            val magnitude = qrGfMultiply(
                gfExp[place % 255],
                qrGfDivide(evaluate(omega, inverse), evaluate(derivative, inverse))
            )
            codeword[size - 1 - place] = codeword[size - 1 - place] ^ magnitude
            found += 1
        }
    }
    if (found != degree) return -1
    for (value in syndromes(codeword, eccCount)) if (value != 0) return -1
    found
}

// How many byte errors a block may correct. Short blocks of version 1 and 2
// keep codewords back for misdecode protection, as the standard's table lists.
fun qrRsCapacity(eccCount: int): int =
    if (eccCount == 7) 2
    else if (eccCount == 10) 4
    else eccCount / 2
