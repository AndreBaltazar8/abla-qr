// The module matrix and the layout both the encoder and the reader rely on.

import "abla/text"
import "tables.ab"

class QrMatrix(
    val size: int,
    val modules: array<bool>,
    val version: int,
    val errorCorrection: QrErrorCorrection,
    val mask: int
) {
    fun dark(x: int, y: int): bool = this.modules[y * this.size + x]
}

fun qrMatrixFromModules(size: int, modules: array<bool>): QrMatrix =
    QrMatrix(size, modules, qrVersionOfSize(size), qrEcLow, -1)

// Rows of 0 and 1, one line each.
fun qrMatrixText(matrix: QrMatrix): string {
    val lines: array<string> = []
    for (y in 0 until matrix.size) {
        val row = filledArray(matrix.size, "0")
        for (x in 0 until matrix.size) if (matrix.dark(x, y)) row[x] = "1"
        lines.append(textJoin(row) + "\n")
    }
    textJoin(lines)
}

fun qrMaskBit(mask: int, x: int, y: int): bool {
    if (mask == 0) return (x + y) % 2 == 0
    if (mask == 1) return y % 2 == 0
    if (mask == 2) return x % 3 == 0
    if (mask == 3) return (x + y) % 3 == 0
    if (mask == 4) return (x / 3 + y / 2) % 2 == 0
    if (mask == 5) return x * y % 2 + x * y % 3 == 0
    if (mask == 6) return (x * y % 2 + x * y % 3) % 2 == 0
    ((x + y) % 2 + x * y % 3) % 2 == 0
}

// Where each function module goes and its colour; `reserved` marks every
// module that isn't a data module, including format and version areas.
class QrLayout(val size: int, val reserved: array<bool>, val dark: array<bool>) {
    fun set(x: int, y: int, value: bool): void {
        this.reserved[y * this.size + x] = true
        this.dark[y * this.size + x] = value
        return
    }
}

private fun drawFinder(var layout: QrLayout, centerX: int, centerY: int): void {
    for (dy in -4..4) {
        for (dx in -4..4) {
            val x = centerX + dx
            val y = centerY + dy
            if (x >= 0 && x < layout.size && y >= 0 && y < layout.size) {
                val ring = max2(abs1(dx), abs1(dy))
                layout.set(x, y, ring != 2 && ring != 4)
            }
        }
    }
    return
}

private fun abs1(value: int): int = if (value < 0) -value else value
private fun max2(a: int, b: int): int = if (a > b) a else b

private fun emptyLayouts(): array<QrLayout?> {
    val result: array<QrLayout?> = []
    for (index in 0..40) result.append(null)
    result
}

private val layouts = emptyLayouts()

fun qrLayout(version: int): QrLayout {
    val cached = layouts[version]
    if (cached != null) return cached
    val size = qrSizeOfVersion(version)
    val layout = QrLayout(size, filledArray(size * size, false), filledArray(size * size, false))
    for (index in 0 until size) {
        layout.set(6, index, index % 2 == 0)
        layout.set(index, 6, index % 2 == 0)
    }
    drawFinder(layout, 3, 3)
    drawFinder(layout, size - 4, 3)
    drawFinder(layout, 3, size - 4)
    val aligned = qrAlignmentPositions(version)
    for (row in 0 until aligned.size) {
        for (column in 0 until aligned.size) {
            val corner = (row == 0 && column == 0) ||
                (row == 0 && column == aligned.size - 1) ||
                (row == aligned.size - 1 && column == 0)
            if (!corner) {
                for (dy in -2..2)
                    for (dx in -2..2)
                        layout.set(aligned[column] + dx, aligned[row] + dy, max2(abs1(dx), abs1(dy)) != 1)
            }
        }
    }
    // Format areas; their colours come with the format word.
    for (index in 0..8) {
        if (index != 6) {
            layout.set(8, index, false)
            layout.set(index, 8, false)
        }
    }
    for (index in 0 until 8) layout.set(size - 1 - index, 8, false)
    for (index in 0 until 8) layout.set(8, size - 1 - index, false)
    layout.set(8, size - 8, true)
    if (version >= 7) {
        for (index in 0 until 18) {
            val near = index / 3
            val far = size - 11 + index % 3
            layout.set(far, near, false)
            layout.set(near, far, false)
        }
    }
    layouts[version] = layout
    layout
}

// The data modules in codeword placement order, as y * size + x.
fun qrDataPath(version: int): array<int> {
    val layout = qrLayout(version)
    val size = layout.size
    val path: array<int> = []
    var right = size - 1
    while (right >= 1) {
        if (right == 6) right = 5
        val upward = ((right + 1) & 2) == 0
        for (vertical in 0 until size) {
            val y = if (upward) size - 1 - vertical else vertical
            for (offset in 0..1) {
                val place = y * size + right - offset
                if (!layout.reserved[place]) path.append(place)
            }
        }
        right -= 2
    }
    path
}

// The 15 format bit places of the first and second copy, least significant
// bit first, as y * size + x.
fun qrFormatPlaces(size: int, copy: int): array<int> {
    val places: array<int> = []
    if (copy == 0) {
        for (index in 0..5) places.append(index * size + 8)
        places.append(7 * size + 8)
        places.append(8 * size + 8)
        places.append(8 * size + 7)
        for (index in 9 until 15) places.append(8 * size + 14 - index)
    } else {
        for (index in 0 until 8) places.append(8 * size + size - 1 - index)
        for (index in 8 until 15) places.append((size - 15 + index) * size + 8)
    }
    places
}

// The 18 version bit places, least significant first, as y * size + x.
fun qrVersionPlaces(size: int, copy: int): array<int> {
    val places: array<int> = []
    for (index in 0 until 18) {
        val far = size - 11 + index % 3
        val near = index / 3
        if (copy == 0) places.append(near * size + far)
        else places.append(far * size + near)
    }
    places
}
