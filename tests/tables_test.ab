import "abla/test"
import "../src/qr.ab"

private fun listText(values: array<int>): string {
    var out = ""
    for (value in values) out = "$out$value,"
    out
}

fun main: int {
    expectEqual(qrSizeOfVersion(1), 21, "version 1 size")
    expectEqual(qrSizeOfVersion(40), 177, "version 40 size")
    expectEqual(qrVersionOfSize(177), 40, "version of size")

    // Capacity table of ISO/IEC 18004.
    expectEqual(qrTotalCodewords(1), 26, "v1 codewords")
    expectEqual(qrTotalCodewords(7), 196, "v7 codewords")
    expectEqual(qrTotalCodewords(40), 3706, "v40 codewords")
    expectEqual(qrDataCodewords(1, qrEcLow), 19, "1-L")
    expectEqual(qrDataCodewords(1, qrEcMedium), 16, "1-M")
    expectEqual(qrDataCodewords(1, qrEcQuartile), 13, "1-Q")
    expectEqual(qrDataCodewords(1, qrEcHigh), 9, "1-H")
    expectEqual(qrDataCodewords(10, qrEcMedium), 216, "10-M")
    expectEqual(qrDataCodewords(25, qrEcQuartile), 718, "25-Q")
    expectEqual(qrDataCodewords(40, qrEcLow), 2956, "40-L")
    expectEqual(qrDataCodewords(40, qrEcHigh), 1276, "40-H")
    expectEqual(qrBlockCount(40, qrEcHigh), 81, "40-H blocks")

    // Every version's blocks must account for its codewords.
    for (version in 1..40) {
        val raw = qrRawDataModules(version)
        expect(raw / 8 * 8 + 7 >= raw, "remainder bits of v$version")
        for (level in 0..3) {
            val ec = QrErrorCorrection(level)
            expect(qrDataCodewords(version, ec) > 0, "v$version level $level has data")
            expect(qrTotalCodewords(version) / qrBlockCount(version, ec) < 256, "v$version level $level block fits GF(256)")
        }
    }

    // Annex E of the standard.
    expectEqual(listText(qrAlignmentPositions(1)), "", "v1 alignment")
    expectEqual(listText(qrAlignmentPositions(2)), "6,18,", "v2 alignment")
    expectEqual(listText(qrAlignmentPositions(7)), "6,22,38,", "v7 alignment")
    expectEqual(listText(qrAlignmentPositions(15)), "6,26,48,70,", "v15 alignment")
    expectEqual(listText(qrAlignmentPositions(32)), "6,34,60,86,112,138,", "v32 alignment")
    expectEqual(listText(qrAlignmentPositions(36)), "6,24,50,76,102,128,154,", "v36 alignment")
    expectEqual(listText(qrAlignmentPositions(40)), "6,30,58,86,114,142,170,", "v40 alignment")

    // Annex C and D.
    expectEqual(qrFormatWord(qrEcMedium, 0), 0x5412, "format M0")
    expectEqual(qrFormatWord(qrEcLow, 0), 0x77C4, "format L0")
    expectEqual(qrFormatWord(qrEcQuartile, 0), 0x355F, "format Q0")
    expectEqual(qrFormatWord(qrEcHigh, 0), 0x1689, "format H0")
    expectEqual(qrFormatWord(qrEcMedium, 5), 0x40CE, "format M5")
    expectEqual(qrVersionWord(7), 0x07C94, "version word 7")
    expectEqual(qrVersionWord(21), 0x15683, "version word 21")
    expectEqual(qrVersionWord(40), 0x28C69, "version word 40")

    expectEqual(qrCharCountBits(qrModeNumeric, 9), 10, "numeric bits, small")
    expectEqual(qrCharCountBits(qrModeNumeric, 26), 12, "numeric bits, medium")
    expectEqual(qrCharCountBits(qrModeNumeric, 27), 14, "numeric bits, large")
    expectEqual(qrCharCountBits(qrModeAlphanumeric, 40), 13, "alphanumeric bits")
    expectEqual(qrCharCountBits(qrModeByte, 9), 8, "byte bits, small")
    expectEqual(qrCharCountBits(qrModeByte, 10), 16, "byte bits, large")
    expectEqual(qrCharCountBits(qrModeKanji, 10), 10, "kanji bits")
    expectEqual(qrAlphanumericValue(58), 44, "colon value")
    expectEqual(qrAlphanumericValue(97), -1, "lower case isn't alphanumeric")
    testsPassed()
}
